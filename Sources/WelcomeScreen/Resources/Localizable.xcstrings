        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входя в систему, вы соглашаетесь с [Лицензионным соглашением](%1$@) и [Политикой конфиденциальности](%2$@)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlásením súhlasíte s [Licenčnou zmluvou](%1$@) a [Zásadami ochrany osobných údajov](%2$@)"
