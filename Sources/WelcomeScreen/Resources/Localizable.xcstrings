{
  "sourceLanguage" : "en",
  "strings" : {
    "legal-agreement" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتسجيل الدخول، فإنك توافق على [اتفاقية الترخيص](%1$@) و[سياسة الخصوصية](%2$@)"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уваходзячы ў сістэму, вы згаджаецеся з [Ліцензійным пагадненнем](%1$@) і [Палітыкай канфідэнцыяльнасці](%2$@)"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Като влезете, вие се съгласявате с [Лицензионното споразумение](%1$@) и [Политиката за поверителност](%2$@)"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iniciar sessió, accepteu el [Acord de llicència](%1$@) i la [Política de privacitat](%2$@)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášením souhlasíte s [Licenční smlouvou](%1$@) a [Zásadami ochrany osobních údajů](%2$@)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved at logge ind accepterer du [Licensaftalen](%1$@) og [Privatlivspolitikken](%2$@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Anmeldung stimmen Sie der [Lizenzvereinbarung](%1$@) und der [Datenschutzerklärung](%2$@) zu"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεόμενοι, συμφωνείτε με τη [Συμφωνία Άδειας](%1$@) και την [Πολιτική Απορρήτου](%2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By signing in, you agree to the [License Agreement](%1$@) and [Privacy Policy](%2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al iniciar sesión, acepta el [Acuerdo de Licencia](%1$@) y la [Política de Privacidad](%2$@)"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al iniciar sesión, aceptas el [Acuerdo de Licencia](%1$@) y la [Política de Privacidad](%2$@)"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با ورود، شما با [توافقنامه مجوز](%1$@) و [سیاست حفظ حریم خصوصی](%2$@) موافقت می‌کنید"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vous connectant, vous acceptez le [Contrat de Licence](%1$@) et la [Politique de Confidentialité](%2$@)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בכניסה, אתה מסכים ל[הסכם הרישיון](%1$@) ול[מדיניות הפרטיות](%2$@)"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavom se slažete s [Licencnim ugovorom](%1$@) i [Pravilima o privatnosti](%2$@)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bejelentkezéssel elfogadja a [Licencszerződést](%1$@) és az [Adatvédelmi irányelveket](%2$@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedendo, accetti il [Contratto di Licenza](%1$@) e l'[Informativa sulla Privacy](%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインすることで、[ライセンス契約](%1$@)および[プライバシーポリシー](%2$@)に同意したことになります"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жүйеге кірсеңіз, [Лицензиялық келісім](%1$@) мен [Құпиялылық саясаты](%2$@)мен келісесіз"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하면 [라이선스 계약](%1$@) 및 [개인정보 처리방침](%2$@)에 동의하게 됩니다"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijungdami sutinkate su [Licencijos sutartimi](%1$@) ir [Privatumo politika](%2$@)"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierakstoties jūs piekrītat [Licences līgumam](%1$@) un [Privātuma politikai](%2$@)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door in te loggen gaat u akkoord met de [Licentieovereenkomst](%1$@) en het [Privacybeleid](%2$@)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logując się, akceptujesz [Umowę licencyjną](%1$@) i [Politykę prywatności](%2$@)"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao iniciar sessão, concorda com o [Contrato de Licença](%1$@) e a [Política de Privacidade](%2$@)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao entrar, você concorda com o [Contrato de Licença](%1$@) e a [Política de Privacidade](%2$@)"
