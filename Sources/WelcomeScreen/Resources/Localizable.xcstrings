        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açarak [Lisans Sözleşmesi](%1$@) ve [Gizlilik Politikası](%2$@)'nı kabul etmiş olursunuz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійшовши в систему, ви погоджуєтеся з [Ліцензійною угодою](%1$@) та [Політикою конфіденційності](%2$@)"
